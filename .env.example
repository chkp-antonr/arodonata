# Example configuration for tests and examples
# This file is NOT used by the arodonata library itself.
# The library receives all configuration via dependency injection.
#
# Copy the relevant sections to .env.test / .env.secrets (both are gitignored
# symlinks into the private vault — never commit real values).

# =============================================================================
# .env (dev / examples — read by ArodonataSettings when constructed bare)
# =============================================================================

MGMT_NAMES=10.0.0.1                 # convention: name == IP for single-server labs
MGMT_SERVERS=10.0.0.1
API_KEYS=your_api_key_here          # actual key value(s), comma-separated
DATABASE_URL=sqlite+aiosqlite:///_tmp/dev_cache.db
ARODONATA_LOG_LEVEL=INFO

# =============================================================================
# .env.test (integration-test lab config, non-secret)
# =============================================================================

API_MGMT=10.0.0.1                   # management server IP for integration tests
# DATABASE_URL=sqlite+aiosqlite:///_tmp/test_cache.db
TEST_DOMAIN_A=DomainA               # MDM sandbox domain for mutating tests
TEST_DOMAIN_B=DomainB               # second MDM sandbox domain (full tier)
CP_REVISION_NAME=                   # optional fixed named restore point
# ARODONATA_LOG_LEVEL=WARNING

# =============================================================================
# .env.secrets (secret — vault only)
# =============================================================================

APIKEY=                             # API key for apikey_client
USER_admin=                         # password for 'admin'
USER_AntonR=                        # password for 'AntonR'
USER_Eng1=                          # passwords for engineer users Eng1..Eng5
USER_Eng2=
USER_Eng3=
USER_Eng4=
USER_Eng5=
